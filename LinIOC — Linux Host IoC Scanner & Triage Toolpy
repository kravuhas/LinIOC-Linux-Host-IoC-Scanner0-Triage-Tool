}


def _port_of(addr: str):
    try:
        return int(addr.rsplit(":", 1)[1])
    except (IndexError, ValueError):
        return None


def scan_ports(args) -> list:
    findings = []
    # Servicos em LISTEN
    for line in run(["ss", "-H", "-tulnp"]).splitlines():
        parts = line.split()
        if len(parts) < 6:
            continue
        local = parts[4]
        port = _port_of(local)
        if port not in SUSPICIOUS_PORTS:
            continue
        motivo, sev = SUSPICIOUS_PORTS[port]
        proc = parts[-1] if parts[-1].startswith("users:") else "n/d (rode como root)"
        findings.append(Finding(
            module="ports", severity=sev, mitre="T1571",
            title=f"Porta {port} em LISTEN ({parts[0]})", description=motivo,
            metadata={"local": local, "process": proc,
                      "exposed": not (local.startswith("127.") or local.startswith("[::1]"))},
        ))
    # Conexoes de saida para portas tipicas de C2
    for line in run(["ss", "-H", "-tnp", "state", "established"]).splitlines():
        parts = line.split()
        if len(parts) < 4:
            continue
        peer = parts[3]
        port = _port_of(peer)
        if port not in SUSPICIOUS_PORTS or peer.startswith("127.") or peer.startswith("[::1]"):
            continue
        motivo, sev = SUSPICIOUS_PORTS[port]
        findings.append(Finding(
            module="ports", severity=sev, mitre="T1571",
            title=f"Conexao ESTABLISHED para porta {port}", description=motivo,
            metadata={"local": parts[2], "peer": peer,
                      "process": parts[4] if len(parts) > 4 else "n/d"},
        ))
    return findings


