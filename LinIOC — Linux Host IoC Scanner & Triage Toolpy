       "cron executando de diretorio volatil", Sev.HIGH, "T1053.003"),
]


def match_rules(text: str) -> list:
    return [r for r in RULES if r.pattern.search(text)]


# ----------------------------------------------------------------
# HELPERS
# ----------------------------------------------------------------
def sha256_file(path: Path, block: int = 1 << 16) -> str:
    h = hashlib.sha256()
    try:
        with open(path, "rb") as f:
            for chunk in iter(lambda: f.read(block), b""):
                h.update(chunk)
        return h.hexdigest()
    except OSError:
        return "indisponivel"


def read_head(path: Path, n: int = 4) -> bytes:
    try:
        with open(path, "rb") as f:
            return f.read(n)
    except OSError:
        return b""


def read_text(path: Path, limit: int = 500_000) -> str:
    try:
        with open(path, "r", encoding="utf-8", errors="ignore") as f:
            return f.read(limit)
    except OSError:
        return ""


def run(cmd: list, timeout: int = 10) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, errors="ignore",
                              timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError) as exc:
        log.debug("falha ao executar %s: %s", cmd[0], exc)
        return ""


def bump(sev: Sev) -> Sev:
    return Sev(min(sev + 1, Sev.CRITICAL))


def top_mitre(rules: list) -> str:
    ordered = sorted(rules, key=lambda r: -r.severity)
    return next((r.mitre for r in ordered if r.mitre), "")


