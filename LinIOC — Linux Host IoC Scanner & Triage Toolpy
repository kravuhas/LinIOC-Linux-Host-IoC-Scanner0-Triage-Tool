DEFAULT_SCAN_DIRS = ["/tmp", "/var/tmp", "/dev/shm", "~/Downloads", "~/Desktop"]
VOLATILE_DIRS = ("/tmp/", "/var/tmp/", "/dev/shm/")
SCRIPT_EXTS = {".sh", ".py", ".pl", ".rb", ".php", ".ps1", ".bat", ".vbs"}
BINARY_EXTS = {".elf", ".bin", ".run", ".so", ".ko", ".out", ".jar"}
WINDOWS_EXTS = {".exe", ".dll", ".msi", ".scr", ".com", ".cmd"}


def iter_files(root: Path, max_depth: int, limit: int):
    if limit <= 0:
        return
    base_depth = len(root.parts)
    count = 0
    for dirpath, dirnames, filenames in os.walk(root, followlinks=False):
        if len(Path(dirpath).parts) - base_depth >= max_depth:
            dirnames[:] = []
        for name in filenames:
            yield Path(dirpath) / name
            count += 1
            if count >= limit:
                return


def analyze_file(path: Path):
    try:
        st = path.lstat()
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or st.st_size == 0:
        return None
    ext = path.suffix.lower()
    head = read_head(path)
    is_elf = head == b"\x7fELF"
    is_script = ext in SCRIPT_EXTS or head[:2] == b"#!"
    is_bin_ext = ext in BINARY_EXTS
    is_win = ext in WINDOWS_EXTS
    if not (is_elf or is_script or is_bin_ext or is_win):
        return None
    if path.resolve() == SELF:
        return None

    is_exec = bool(st.st_mode & 0o111)
    volatile = str(path).startswith(VOLATILE_DIRS)
    hidden = path.name.startswith(".")
    matches = match_rules(read_text(path)) if is_script else []

    sev, reasons, mitre = Sev.INFO, [], ""
    if matches:
        sev = max(m.severity for m in matches)
        reasons += [m.name for m in matches]
        mitre = top_mitre(matches)
    if (is_elf or is_bin_ext) and is_exec and volatile:
        sev = max(sev, Sev.HIGH)
        reasons.append("binario executavel em diretorio volatil")
    elif is_elf and volatile:
        sev = max(sev, Sev.LOW)
        reasons.append("ELF em diretorio volatil")
    if hidden and is_exec and volatile:
        sev = max(sev, Sev.HIGH)
        reasons.append("arquivo oculto executavel em diretorio volatil")
        mitre = mitre or "T1564.001"
    if is_script and is_exec and volatile:
        sev = max(sev, Sev.MEDIUM)
        reasons.append("script executavel em diretorio volatil")
    if is_win:
        sev = max(sev, Sev.LOW)
        reasons.append("binario Windows em host Linux")
    if matches and volatile:
        sev = bump(sev)
    if sev == Sev.INFO:
        return None

    return Finding(
        module="files", severity=sev, title=str(path), description="; ".join(reasons), mitre=mitre,
        metadata={"sha256": sha256_file(path), "size": st.st_size,
                  "mode": oct(stat.S_IMODE(st.st_mode)),
                  "mtime": datetime.fromtimestamp(st.st_mtime, timezone.utc).isoformat(),
                  "rules": [m.name for m in matches]},
    )


def scan_files(args) -> list:
    roots = [Path(p).expanduser() for p in DEFAULT_SCAN_DIRS + args.dir]
    candidates = []
    for root in roots:
        if not root.is_dir():
            continue
        candidates.extend(iter_files(root, args.depth, args.max_files - len(candidates)))
        if len(candidates) >= args.max_files:
            log.warning("Limite de %d arquivos atingido (use --max-files)", args.max_files)
            break
    candidates = list(dict.fromkeys(candidates))
    with ThreadPoolExecutor(max_workers=8) as pool:
        return [f for f in pool.map(analyze_file, candidates) if f]


