    _r(r"\b(nc|ncat|netcat)\b[^\n]*\s-e\s", "netcat com -e (shell remota)", Sev.CRITICAL, "T1059.004"),
    _r(r"os\.dup2\([^\n]*fileno", "dup2 em socket (reverse shell Python)", Sev.CRITICAL, "T1059.006"),
    _r(r"reverse[_-]?shell|bind[_-]?shell", "termo reverse/bind shell", Sev.HIGH, "T1059"),
    # Download & execute / ofuscacao
    _r(r"\b(curl|wget)\b[^\n|]*\|\s*(sudo\s+)?(ba|z|da)?sh\b", "download piped para shell", Sev.HIGH, "T1105"),
    _r(r"base64\s+(-d|--decode)[^\n]*\|\s*(ba|z|da)?sh\b", "payload base64 -> shell", Sev.HIGH, "T1027"),
    _r(r"\b(eval|exec)\s*\(\s*(base64\.|bytes\.fromhex|codecs\.decode|zlib\.decompress)",
       "eval/exec ofuscado", Sev.HIGH, "T1027"),
    # Ferramentas ofensivas / malware
    _r(r"\b(msfvenom|msfconsole|meterpreter|mimikatz)\b", "ferramenta ofensiva", Sev.HIGH, "T1588.002"),
    _r(r"\b(keylogger|rootkit|ransomware)\b", "termo de malware", Sev.MEDIUM, ""),
    # Execucao / evasao (contexto-dependente => severidade menor)
    _r(r"subprocess\.(call|run|Popen)\([^\n]*shell\s*=\s*True", "subprocess com shell=True", Sev.MEDIUM, "T1059.006"),
    _r(r"chmod\s+\+?[0-7]*x[^\n]*(/tmp|/dev/shm|/var/tmp)", "chmod +x em diretorio volatil", Sev.MEDIUM, "T1222.002"),
    _r(r"ctypes\.(windll|cdll|CDLL)", "carga de biblioteca nativa (ctypes)", Sev.MEDIUM, "T1106"),
