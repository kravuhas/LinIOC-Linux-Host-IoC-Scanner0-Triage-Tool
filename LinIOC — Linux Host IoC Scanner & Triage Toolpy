def build_summary(findings: list, timings: dict) -> dict:
    counts = {s.name: sum(1 for f in findings if f.severity == s) for s in Sev}
    top = max((f.severity for f in findings), default=None)
    return {
        "scanner": f"LinIOC v{VERSION}",
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "host": platform.node(),
        "kernel": platform.release(),
        "running_as_root": hasattr(os, "geteuid") and os.geteuid() == 0,
        "total_findings": len(findings),
        "by_severity": {k: v for k, v in counts.items() if v},
        "risk_score": sum(SEV_WEIGHT[f.severity] for f in findings),
        "risk_level": top.name if top is not None else "CLEAN",
        "mitre_techniques": sorted({f.mitre for f in findings if f.mitre}),
        "module_timings_s": {k: round(v, 2) for k, v in timings.items()},
    }


def write_reports(findings: list, summary: dict, out_dir: Path, fmt: str) -> list:
    out_dir.mkdir(parents=True, exist_ok=True)
    stamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    written = []

    if fmt in ("txt", "both"):
        path = out_dir / f"linioc_{stamp}.txt"
        with open(path, "w", encoding="utf-8") as f:
            f.write("=" * 68 + f"\n  LinIOC v{VERSION} - RELATORIO DE TRIAGEM\n")
            f.write(f"  {summary['generated_at']} | Host: {summary['host']}\n" + "=" * 68 + "\n\n")
            f.write(f"Achados: {summary['total_findings']} | Score: {summary['risk_score']} | "
                    f"Nivel: {summary['risk_level']}\n")
            if summary["mitre_techniques"]:
                f.write("MITRE ATT&CK: " + ", ".join(summary["mitre_techniques"]) + "\n")
            f.write("\n")
            for fnd in sorted(findings, key=lambda x: -x.severity):
                tag = f" [{fnd.mitre}]" if fnd.mitre else ""
                f.write(f"{SEV_EMOJI[fnd.severity]} [{fnd.severity.name}] ({fnd.module}){tag} {fnd.title}\n")
                if fnd.description:
                    f.write(f"    {fnd.description}\n")
                for k, v in fnd.metadata.items():
                    f.write(f"    {k}: {v}\n")
                f.write("-" * 68 + "\n")
        written.append(path)

    if fmt in ("json", "both"):
        path = out_dir / f"linioc_{stamp}.json"
        payload = {**summary, "findings": [f.to_dict() for f in
                                           sorted(findings, key=lambda x: -x.severity)]}
        path.write_text(json.dumps(payload, ensure_ascii=False, indent=2), encoding="utf-8")
        written.append(path)

    for p in written:  # relatorio contem caminhos e hashes do host: acesso restrito
        try:
            os.chmod(p, 0o600)
        except OSError:
            pass
    return written


# ----------------------------------------------------------------
# CLI
# ----------------------------------------------------------------
MODULES = {
    "extensions": scan_extensions,
    "files": scan_files,
    "ports": scan_ports,
    "processes": scan_processes,
    "persistence": scan_persistence,
}


def sev_arg(value: str) -> Sev:
    try:
        return Sev[value.upper()]
    except KeyError:
        raise argparse.ArgumentTypeError(
            f"severidade invalida: {value} (use {', '.join(s.name.lower() for s in Sev)})")


def exit_code(findings: list, fail_on) -> int:
    top = max((f.severity for f in findings), default=Sev.INFO)
    if fail_on is not None:
        return 2 if top >= fail_on else 0
    return 2 if top >= Sev.HIGH else 1 if top == Sev.MEDIUM else 0


def main() -> None:
    ap = argparse.ArgumentParser(description=f"LinIOC v{VERSION} - Linux Host IoC Scanner & Triage Tool")
    ap.add_argument("-d", "--dir", action="append", default=[], help="diretorio extra para varrer (repetivel)")
    ap.add_argument("-o", "--output", default=".", help="diretorio dos relatorios (padrao: atual)")
    ap.add_argument("-f", "--format", choices=["txt", "json", "both"], default="both")
    ap.add_argument("-m", "--modules", default="all",
                    help="all ou lista separada por virgula: " + ",".join(MODULES))
    ap.add_argument("--min-severity", type=sev_arg, default=Sev.LOW,
                    help="severidade minima reportada (padrao: low)")
    ap.add_argument("--fail-on", type=sev_arg, default=None,
                    help="exit 2 se houver achado >= severidade (senao: 0/1/2 padrao)")
    ap.add_argument("--depth", type=int, default=3, help="profundidade da varredura de arquivos (padrao: 3)")
    ap.add_argument("--max-files", type=int, default=20000, help="limite de arquivos analisados")
    ap.add_argument("-q", "--quiet", action="store_true", help="somente warnings/erros")
    ap.add_argument("-v", "--verbose", action="store_true", help="log de debug")
    args = ap.parse_args()

    logging.basicConfig(
        level=logging.DEBUG if args.verbose else logging.WARNING if args.quiet else logging.INFO,
        format="%(levelname)s [%(name)s] %(message)s", stream=sys.stderr,
    )

    if not sys.platform.startswith("linux"):
        log.warning("LinIOC foi feito para Linux; resultados podem ser incompletos neste SO.")
    if hasattr(os, "geteuid") and os.geteuid() != 0:
        log.warning("Sem root: nomes de processo em 'ports' e cron do sistema podem ficar limitados.")

    selected = list(MODULES) if args.modules == "all" else [m.strip() for m in args.modules.split(",")]
    unknown = [m for m in selected if m not in MODULES]
    if unknown:
        ap.error(f"modulo(s) desconhecido(s): {', '.join(unknown)}")

    findings, timings = [], {}
    for name in selected:
        log.info("Modulo %s", name)
        t0 = time.time()
        try:
            findings += MODULES[name](args)
        except Exception:  # um modulo com erro nao derruba o scan inteiro
            log.exception("Modulo %s falhou", name)
        timings[name] = time.time() - t0

    findings = [f for f in findings if f.severity >= args.min_severity]
    summary = build_summary(findings, timings)
    written = write_reports(findings, summary, Path(args.output), args.format)

    print("\n" + "=" * 68)
    print(f"  LinIOC v{VERSION} | {summary['total_findings']} achados | "
          f"score {summary['risk_score']} | nivel {summary['risk_level']} | "
          f"{sum(timings.values()):.1f}s")
    for s in sorted(Sev, reverse=True):
        n = summary["by_severity"].get(s.name)
        if n:
            print(f"  {SEV_EMOJI[s]} {s.name}: {n}")
    if summary["mitre_techniques"]:
        print("  MITRE ATT&CK: " + ", ".join(summary["mitre_techniques"]))
    for p in written:
        print(f"  📄 {p}")
    print("=" * 68)

    sys.exit(exit_code(findings, args.fail_on))


if __name__ == "__main__":
    main()
