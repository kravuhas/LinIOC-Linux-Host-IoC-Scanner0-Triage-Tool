def _persistence_finding(text: str, label: str, default_mitre: str, meta: dict):
    matches = match_rules(text)
    if not matches:
        return None
    sev = max(m.severity for m in matches)
    if sev >= Sev.MEDIUM:  # em local de persistencia o mesmo padrao e mais grave
        sev = bump(sev)
    return Finding(
        module="persistence", severity=sev, title=f"Codigo suspeito em {label}",
        description=", ".join(m.name for m in matches[:4]),
        mitre=top_mitre(matches) or default_mitre,
        metadata={**meta, "rules": [m.name for m in matches]},
    )


def scan_persistence(args) -> list:
    findings = []
    for location, mitre in PERSISTENCE_TARGETS:
        p = Path(location).expanduser()
        if not p.exists():
            continue
        files = []
        if p.is_file():
            files = [p]
        elif p.is_dir():
            try:
                files = [f for f in p.iterdir() if f.is_file() and f.stat().st_size < 1_000_000]
            except OSError:
                log.warning("Sem permissao em %s", p)
        for f in files:
            item = _persistence_finding(read_text(f), str(f), mitre,
                                        {"path": str(f), "sha256": sha256_file(f)})
            if item:
                findings.append(item)

    cron = run(["crontab", "-l"])
    if cron:
        item = _persistence_finding(cron, "crontab do usuario atual", "T1053.003", {})
        if item:
            findings.append(item)

    preload = Path("/etc/ld.so.preload")
    if preload.is_file() and preload.stat().st_size > 0:
        findings.append(Finding(
            module="persistence", severity=Sev.HIGH, mitre="T1574.006",
            title="/etc/ld.so.preload presente e nao vazio",
            description="tecnica classica de rootkit em userland; validar cada biblioteca listada",
            metadata={"conteudo": read_text(preload, 2000).strip()},
        ))

    keys = Path("~/.ssh/authorized_keys").expanduser()
    if keys.is_file():
        n = sum(1 for l in read_text(keys).splitlines() if l.strip() and not l.startswith("#"))
        findings.append(Finding(
            module="persistence", severity=Sev.INFO, mitre="T1098.004",
            title=f"authorized_keys com {n} chave(s)",
            description="revisar se todas as chaves sao reconhecidas",
            metadata={"path": str(keys)},
        ))
    return findings


