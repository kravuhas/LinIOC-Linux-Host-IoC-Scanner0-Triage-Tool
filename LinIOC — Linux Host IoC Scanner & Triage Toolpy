OFFENSIVE_PROCS = {
    "msfconsole": Sev.HIGH, "msfvenom": Sev.HIGH, "mimikatz": Sev.HIGH, "responder": Sev.HIGH,
    "bettercap": Sev.MEDIUM, "ettercap": Sev.MEDIUM, "arpspoof": Sev.MEDIUM, "hydra": Sev.MEDIUM,
    "sqlmap": Sev.MEDIUM, "aircrack-ng": Sev.MEDIUM, "hashcat": Sev.MEDIUM, "john": Sev.MEDIUM,
    "tcpdump": Sev.LOW, "wireshark": Sev.LOW, "tshark": Sev.LOW,
}
NETCAT_NAMES = {"nc", "ncat", "netcat"}


def scan_processes(args) -> list:
    findings = []
    me = str(os.getpid())
    for line in run(["ps", "-eo", "pid=,user=,comm=,args="]).splitlines():
        parts = line.split(None, 3)
        if len(parts) < 3 or parts[0] == me:
            continue
        pid, user, comm = parts[:3]
        cmdline = parts[3] if len(parts) > 3 else ""
        name = comm.lower()
        meta = {"pid": pid, "user": user, "cmdline": cmdline[:200]}

        if name in NETCAT_NAMES:
            listening = bool(re.search(r"\s-\w*l", cmdline))
            findings.append(Finding(
                module="processes", severity=Sev.HIGH if listening else Sev.MEDIUM, mitre="T1095",
                title=f"netcat ({comm}) em execucao", metadata=meta,
                description="modo listener (possivel bind shell)" if listening else "conexao ativa",
            ))
        elif name in OFFENSIVE_PROCS:
            findings.append(Finding(
                module="processes", severity=OFFENSIVE_PROCS[name], mitre="T1588.002",
                title=f"Ferramenta ofensiva/dual-use em execucao: {comm}", metadata=meta,
                description="pode ser uso legitimo (pentest/troubleshooting); validar com o dono do host",
            ))

        # Binario rodando de diretorio volatil ou ja deletado do disco
        try:
            exe = os.readlink(f"/proc/{pid}/exe")
        except OSError:
            continue
        if exe.endswith(" (deleted)") or exe.startswith(VOLATILE_DIRS):
            if exe.startswith("/memfd:"):
                sev, why = Sev.MEDIUM, "execucao via memfd (fileless; tambem usado por runtimes de container)"
            elif exe.endswith(" (deleted)"):
                sev, why = Sev.HIGH, "binario deletado do disco enquanto em execucao"
            else:
                sev, why = Sev.HIGH, "binario em diretorio volatil"
            findings.append(Finding(
                module="processes", severity=sev, mitre="T1036",
                title=f"Processo {comm} executando de local suspeito",
                description=why, metadata={**meta, "exe": exe},
            ))
    return findings


