BROWSER_ROOTS = {
    "Chrome": "~/.config/google-chrome",
    "Chromium": "~/.config/chromium",
    "Brave": "~/.config/BraveSoftware/Brave-Browser",
    "Edge": "~/.config/microsoft-edge",
    "Vivaldi": "~/.config/vivaldi",
    "Opera": "~/.config/opera",
}
CRITICAL_PERMS = {"nativeMessaging", "proxy", "debugger", "management", "webRequestBlocking"}
DATA_PERMS = {"tabs", "webRequest", "cookies", "history", "bookmarks", "downloads", "clipboardRead",
              "geolocation", "privacy", "contentSettings", "declarativeNetRequest",
              "declarativeNetRequestFeedback"}
BROAD_HOSTS = {"<all_urls>", "http://*/*", "https://*/*", "*://*/*"}


def _resolve_ext_name(manifest: dict, version_dir: Path) -> str:
    name = str(manifest.get("name", "Desconhecido"))
    m = re.fullmatch(r"__MSG_(.+)__", name)
    if not m:
        return name
    key = m.group(1).lower()
    for loc in (manifest.get("default_locale"), "en", "en_US", "pt_BR"):
        if not loc:
            continue
        try:
            data = json.loads((version_dir / "_locales" / loc / "messages.json")
                              .read_text(encoding="utf-8"))
        except (OSError, ValueError):
            continue
        for k, v in data.items():
            if k.lower() == key and isinstance(v, dict):
                return v.get("message", name)
    return name


def scan_extensions(args) -> list:
    findings = []
    for browser, root in BROWSER_ROOTS.items():
        base = Path(root).expanduser()
        if not base.is_dir():
            continue
        ext_dirs = list(base.glob("*/Extensions")) + [base / "Extensions"]
        for ext_dir in filter(Path.is_dir, ext_dirs):
            for ext_id in ext_dir.iterdir():
                if not ext_id.is_dir():
                    continue
                for version_dir in ext_id.iterdir():
                    manifest_path = version_dir / "manifest.json"
                    if not manifest_path.is_file():
                        continue
                    try:
                        manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
                    except (ValueError, OSError):
                        continue
                    perms = {p for p in list(manifest.get("permissions", []))
                             + list(manifest.get("host_permissions", [])) if isinstance(p, str)}
                    crit = sorted(perms & CRITICAL_PERMS)
                    data = sorted(perms & DATA_PERMS)
                    broad = bool(perms & BROAD_HOSTS)
                    score = 2 * len(crit) + len(data) + (2 if broad else 0)
                    sev = Sev.HIGH if score >= 8 else Sev.MEDIUM if score >= 4 else \
                        Sev.LOW if score >= 1 else Sev.INFO
                    risks = crit + data + (["ACESSO A TODOS OS SITES"] if broad else [])
                    findings.append(Finding(
                        module="extensions", severity=sev, mitre="T1176",
                        title=f"[{browser}] {_resolve_ext_name(manifest, version_dir)} "
                              f"v{manifest.get('version', '?')}",
                        description=", ".join(risks) if risks else "sem permissoes de risco",
                        metadata={"browser": browser, "extension_id": ext_id.name,
                                  "risk_score": score, "permissions_at_risk": risks},
                    ))
    return findings


