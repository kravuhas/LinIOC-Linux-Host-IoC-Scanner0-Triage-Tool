# ----------------------------------------------------------------
# SEVERIDADE E FINDING
# ----------------------------------------------------------------
class Sev(IntEnum):
    INFO = 0
    LOW = 1
    MEDIUM = 2
    HIGH = 3
    CRITICAL = 4


SEV_EMOJI = {Sev.INFO: "ℹ️ ", Sev.LOW: "🟢", Sev.MEDIUM: "🟡", Sev.HIGH: "🔴", Sev.CRITICAL: "🚨"}
SEV_WEIGHT = {Sev.INFO: 0, Sev.LOW: 1, Sev.MEDIUM: 3, Sev.HIGH: 7, Sev.CRITICAL: 15}


@dataclass
class Finding:
    module: str
    severity: Sev
    title: str
    description: str = ""
    mitre: str = ""
    metadata: dict = field(default_factory=dict)

    def to_dict(self) -> dict:
        return {
            "module": self.module,
            "severity": self.severity.name,
            "title": self.title,
            "description": self.description,
            "mitre": self.mitre,
            "metadata": self.metadata,
        }


# ----------------------------------------------------------------
# REGRAS DE DETECCAO (regex + severidade + tecnica MITRE ATT&CK)
# ----------------------------------------------------------------
@dataclass(frozen=True)
class Rule:
    pattern: re.Pattern
    name: str
    severity: Sev
    mitre: str


def _r(pattern: str, name: str, sev: Sev, mitre: str = "") -> Rule:
    return Rule(re.compile(pattern, re.IGNORECASE | re.MULTILINE), name, sev, mitre)


